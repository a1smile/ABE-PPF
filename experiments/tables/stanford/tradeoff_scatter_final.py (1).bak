import csv
import matplotlib.pyplot as plt
import numpy as np

CSV_PATH = "summary_stats.csv"
OUT_PDF = "tradeoff_scatter_final.pdf"
OUT_SVG = "tradeoff_scatter_final.svg"

name_map = {
    "baseline": "Baseline",
    "no_pose": "w/o Pose",
    "no_robust": "w/o Robust Vote",
    "no_rsmrq": "w/o RSMRQ",
    "ours": "Ours",
}

rows = []
with open(CSV_PATH, "r", encoding="utf-8") as f:
    rows = list(csv.DictReader(f))

methods_raw = [r["method"] for r in rows]
methods = [name_map.get(m, m) for m in methods_raw]

time_mean = np.array([float(r["time_mean"]) for r in rows], dtype=float)
add_mean = np.array([float(r["add_mean"]) for r in rows], dtype=float)
add_success = np.array([float(r["add_success"]) for r in rows], dtype=float)

ours_idx = methods_raw.index("ours") if "ours" in methods_raw else None

plt.rcParams.update({
    "font.size": 8.5,
    "axes.labelsize": 9,
    "xtick.labelsize": 8,
    "ytick.labelsize": 8,
    "legend.fontsize": 8,
    "pdf.fonttype": 42,
    "ps.fonttype": 42,
})

# Figure 1: Time vs ADD mean
fig, ax = plt.subplots(figsize=(5.2, 4.1))

for i, name in enumerate(methods):
    if i == ours_idx:
        ax.scatter(time_mean[i], add_mean[i], s=95, marker='o', zorder=4, label="Ours")
        ax.annotate(
            name,
            xy=(time_mean[i], add_mean[i]),
            xytext=(8, -2),
            textcoords="offset points",
            fontsize=8.5,
            fontweight="bold",
        )
    else:
        ax.scatter(time_mean[i], add_mean[i], s=70, marker='o', zorder=3)
        ax.annotate(
            name,
            xy=(time_mean[i], add_mean[i]),
            xytext=(6, 4),
            textcoords="offset points",
            fontsize=8,
        )

ax.set_xscale("log")
ax.set_xlabel("Registration Time (s, log scale)")
ax.set_ylabel("ADD Mean")
ax.set_title("Accuracy-Efficiency Trade-off")
ax.grid(alpha=0.22, linewidth=0.6)
ax.set_axisbelow(True)

# Emphasize favorable region: lower-left is better
ax.annotate(
    "better",
    xy=(time_mean.min(), add_mean.min()),
    xytext=(18, 14),
    textcoords="offset points",
    fontsize=8,
)

for spine in ["top", "right"]:
    ax.spines[spine].set_visible(False)

plt.tight_layout()
plt.savefig(OUT_PDF, bbox_inches="tight")
plt.savefig(OUT_SVG, bbox_inches="tight")
plt.show()

# Figure 2: optional companion metric
fig2, ax2 = plt.subplots(figsize=(5.2, 4.1))

for i, name in enumerate(methods):
    if i == ours_idx:
        ax2.scatter(time_mean[i], add_success[i], s=95, marker='o', zorder=4, label="Ours")
        ax2.annotate(
            name,
            xy=(time_mean[i], add_success[i]),
            xytext=(8, -2),
            textcoords="offset points",
            fontsize=8.5,
            fontweight="bold",
        )
    else:
        ax2.scatter(time_mean[i], add_success[i], s=70, marker='o', zorder=3)
        ax2.annotate(
            name,
            xy=(time_mean[i], add_success[i]),
            xytext=(6, 4),
            textcoords="offset points",
            fontsize=8,
        )

ax2.set_xscale("log")
ax2.set_xlabel("Registration Time (s, log scale)")
ax2.set_ylabel("Success Rate @ ADD<0.02")
ax2.set_title("Success-Efficiency Trade-off")
ax2.grid(alpha=0.22, linewidth=0.6)
ax2.set_axisbelow(True)

for spine in ["top", "right"]:
    ax2.spines[spine].set_visible(False)

plt.tight_layout()
plt.savefig("tradeoff_success_final.pdf", bbox_inches="tight")
plt.savefig("tradeoff_success_final.svg", bbox_inches="tight")
plt.show()

print("Saved:", OUT_PDF)
print("Saved:", OUT_SVG)
print("Saved: tradeoff_success_final.pdf")
print("Saved: tradeoff_success_final.svg")
